{
    "custom_module": "ivp",
    "supported_methods": [
        "euler",
        "heun",
        "rk2",
        "rk4",
        "rk4_system",
        "adams_bashforth_2",
        "adams_bashforth_3",
        "adams_moulton_2"
    ],
    "system_methods": ["rk4_system"],
    "max_equations": 6,
    "component_map": {
        "method_selector": "app.layout.ode_ivp.components.ivp_method.ivp_method",
        "input_mode": "app.layout.ode_ivp.components.ivp_input_mode.ivp_input_mode",
        "input_area": "app.layout.ode_ivp.components.ivp_input_area.ivp_input_area",
        "run_button": "app.layout.ode_ivp.components.ivp_btn.ivp_run_btn"
    },
    "component_params": {
        "method_selector": {
            "options": "method_selector_options"
        },
        "input_mode": {
            "options": "input_mode_selector_options"
