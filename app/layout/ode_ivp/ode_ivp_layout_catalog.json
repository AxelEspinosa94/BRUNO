    "method_selector_options": [
        {"label": "Euler",                   "value": "euler"},
        {"label": "Heun",                    "value": "heun"},
        {"label": "Runge-Kutta 2 (Midpoint)", "value": "rk2"},
        {"label": "Runge-Kutta 4",           "value": "rk4"},
        {"label": "Runge-Kutta 4 (System)",  "value": "rk4_system"},
        {"label": "Adams-Bashforth 2",       "value": "adams_bashforth_2"},
        {"label": "Adams-Bashforth 3",       "value": "adams_bashforth_3"},
        {"label": "Adams-Moulton 2 (PECE)",  "value": "adams_moulton_2"}
    ],
    "input_mode_selector_options": [{"label": "Function f(x, y)", "value": "function"}],
    "header_contents": {
        "h2": "Differential Equations — Initial Value Problems",
        "p": "A differential equation tells you how things change; an initial value tells you where they start. Step by step, numerical methods turn both into a trajectory."
